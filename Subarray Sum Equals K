class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        unordered_map<int, int> sumFreq;
        sumFreq[0] = 1; // base case: prefix sum 0 occurs once
        
        int count = 0, curr_sum = 0;
        
        for (int num : nums) {
            curr_sum += num;
            
            if (sumFreq.find(curr_sum - k) != sumFreq.end()) {
                count += sumFreq[curr_sum - k];
            }
            
            sumFreq[curr_sum]++;
        }
        
        return count;
    }
};
