#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        vector<int> pos, neg;

        for (int x : nums) {
            if (x > 0) pos.push_back(x);
            else neg.push_back(x);
        }

        vector<int> ans(n);
        int i = 0, j = 0, k = 0;

        while (i < pos.size() && j < neg.size()) {
            ans[k++] = pos[i++];
            ans[k++] = neg[j++];
        }

        return ans;
    }
};

