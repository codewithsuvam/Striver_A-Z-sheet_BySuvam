#solve this problem by cpp 
#include <vector>
#include <algorithm>
using namespace std;

class Solution {
public:
    void rotate(vector<int>& nums, int k) {
        int n = nums.size();
        k %= n; // handle k > n

#step 1: reverse all
        reverse(nums.begin(), nums.end());
        # step 2: reverse first k
        reverse(nums.begin(), nums.begin() + k);
        #step 3: reverse remaining 
        reverse(nums.begin() + k, nums.end());
    }
};
