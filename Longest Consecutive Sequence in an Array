#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> a(n);

    for(int i = 0; i < n; i++) cin >> a[i];

    unordered_set<int> st(a.begin(), a.end());
    int longest = 0;

    for(int x : a) {
        if(!st.count(x - 1)) {
            int curr = x;
            int cnt = 1;

            while(st.count(curr + 1)) {
                curr++;
                cnt++;
            }
            longest = max(longest, cnt);
        }
    }

    cout << longest;
    return 0;
}
